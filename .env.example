# ---------------------------------------------------------------------------
# kivitendo-erp Docker Compose – Umgebungsvariablen
# Kopieren nach .env und Werte anpassen.
# ---------------------------------------------------------------------------

# PostgreSQL-Datenbank
# DB_USER=postgres nutzt den PostgreSQL-Superuser (für Datenbankverwaltung
# über die kivitendo-Adminoberfläche erforderlich).
# DB_PASSWORD bleibt leer, da POSTGRES_HOST_AUTH_METHOD=trust gesetzt ist.
DB_USER=postgres
DB_PASSWORD=
DB_NAME=kivitendo_auth
DB_PORT=5432

# kivitendo Admin-Passwort (Zugang unter /admin bzw.
# /controller.pl?action=Admin/login)
ADMIN_PASSWORD=admin123

# SMTP-Konfiguration
# Im Entwicklungsmodus: MailHog fängt alle ausgehenden E-Mails ab.
SMTP_HOST=mailhog
SMTP_PORT=1025

# Geheimschlüssel zum Verschlüsseln sensibler Daten in der Datenbank.
# Bitte durch einen sicheren Zufallswert ersetzen (z. B. openssl rand -hex 32).
SECRET_MASTER_KEY=

# Ports für den Host-Zugriff
APP_PORT=8080
MAILHOG_PORT=8025
MAILHOG_SMTP_PORT=1025
