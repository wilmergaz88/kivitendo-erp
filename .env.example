# ---------------------------------------------------------------------------
# kivitendo-erp Docker Compose – Umgebungsvariablen
# Kopieren nach .env und Werte anpassen.
# ---------------------------------------------------------------------------

# PostgreSQL-Datenbank
DB_USER=kivitendo
DB_PASSWORD=kivitendo
DB_NAME=kivitendo_auth
DB_PORT=5432

# kivitendo Admin-Passwort (Zugang unter /controller.pl?action=Admin/login)
ADMIN_PASSWORD=admin123

# SMTP-Konfiguration (MailHog als Entwicklungs-SMTP-Server)
SMTP_HOST=mailhog
SMTP_PORT=1025

# Geheimschlüssel zum Verschlüsseln sensibler Daten in der Datenbank
# Bitte durch einen sicheren Zufallswert ersetzen!
SECRET_MASTER_KEY=changeme-bitte-durch-zufallswert-ersetzen

# Ports für den Host-Zugriff
APP_PORT=8080
MAILHOG_PORT=8025
